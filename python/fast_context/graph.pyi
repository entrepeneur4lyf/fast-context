    # Directed Graph Specific Algorithms
    def strongly_connected_components(self) -> List[ConnectedComponent]: ...
    
    def weakly_connected_components(self) -> List[ConnectedComponent]: ...
    
    def clone(self) -> 'PyRustworkxDiGraph': ...
    
    def __str__(self) -> str: ...
    
    def __repr__(self) -> str: ...


# Convenience aliases
Graph = PyRustworkxGraph
DiGraph = PyRustworkxDiGraph