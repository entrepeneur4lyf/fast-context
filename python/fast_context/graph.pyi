    def add_edge(self, source: int, target: int, weight: Optional[float] = None) -> Optional[int]: ...
    
    def remove_edge(self, source: int, target: int) -> bool: ...
    
    @property
    def node_count(self) -> int: ...
    
    @property
    def edge_count(self) -> int: ...
    
    def is_empty(self) -> bool: ...
    
    def clear(self) -> None: ...
    
    def successors(self, node_index: int) -> List[int]: ...
    
    def predecessors(self, node_index: int) -> List[int]: ...
    
