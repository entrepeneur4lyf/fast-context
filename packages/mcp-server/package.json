{
  "name": "@fast-context/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Fast-Context codebase analysis integration with AI assistants",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },

  "scripts": {
    "build": "tsc",
    "dev": "tsx src/examples/stdio-server.ts",
    "dev:http": "tsx src/examples/http-server.ts",
    "start": "node dist/examples/stdio-server.js",
    "start:http": "node dist/examples/http-server.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "type-check": "tsc --noEmit",
    "test": "echo \"Tests will be added in future version\" && exit 0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-assistant",
    "codebase-analysis",
    "fast-context",
    "typescript",
    "claude",
    "context-retrieval",
    "code-intelligence"
  ],
  "author": {
    "name": "Shawn McAllister",
    "email": "shawn.payments@gmail.com",
    "url": "https://x.com/entrepeneur4lyf"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@fast-context/core": "file:../core",
    "zod": "^3.22.4",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs/issues"
  },
  "homepage": "https://github.com/entrepeneur4lyf/rustworkx-nodejs/tree/main/packages/mcp-server"
}
