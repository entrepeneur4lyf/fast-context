{
  "name": "@fast-context/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Fast-Context codebase analysis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/examples/stdio-server.ts",
    "dev:http": "tsx src/examples/http-server.ts",
    "start": "node dist/examples/stdio-server.js",
    "start:http": "node dist/examples/http-server.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "codebase-analysis",
    "fast-context",
    "typescript"
  ],
  "author": "Fast-Context Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@fast-context/core": "workspace:*",
    "zod": "^3.22.4",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs/issues"
  },
  "homepage": "https://github.com/entrepeneur4lyf/rustworkx-nodejs/tree/main/packages/mcp-server"
}
