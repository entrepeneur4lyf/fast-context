{
  "name": "@fast-context/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Fast-Context codebase analysis engine with interactive REPL and comprehensive developer tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "fast-context": "dist/bin/cli.js",
    "fc": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node src/bin/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cli",
    "codebase-analysis",
    "developer-tools",
    "typescript",
    "code-intelligence",
    "fast-context",
    "repl",
    "interactive",
    "command-line",
    "analysis",
    "static-analysis",
    "ast"
  ],
  "author": {
    "name": "Shawn McAllister",
    "email": "shawn.payments@gmail.com",
    "url": "https://x.com/entrepeneur4lyf"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/entrepeneur4lyf/rustworkx-nodejs#readme",
  "bugs": {
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs/issues"
  },
  "dependencies": {
    "@fast-context/core": "file:../core",
    "commander": "^11.0.0",
    "inquirer": "^9.0.0",
    "chalk": "^5.0.0",
    "ora": "^8.0.0",
    "cli-table3": "^0.6.0",
    "boxen": "^7.0.0",
    "figlet": "^1.7.0",
    "debug": "^4.3.0",
    "js-yaml": "^4.1.0",
    "csv-writer": "^1.6.0",
    "markdown-table": "^3.0.0",
    "cli-progress": "^3.12.0",
    "chokidar": "^3.5.0",
    "fast-glob": "^3.3.0",
    "minimatch": "^9.0.0",
    "semver": "^7.5.0",
    "update-notifier": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/inquirer": "^9.0.7",
    "@types/figlet": "^1.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/debug": "^4.1.12",
    "@types/semver": "^7.5.8",
    "@types/cli-progress": "^3.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs.git",
    "directory": "packages/cli"
  }
}
