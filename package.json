{
  "name": "fast-context",
  "version": "0.1.0",
  "description": "Intelligent codebase analysis engine for coding assistants with graph-powered code comprehension",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "*.node"
  ],
  "napi": {
    "name": "fast-context",
    "triples": {
      "defaults": true
    }
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/events": "^3.0.3",
    "@types/node": "^20.0.0",
    "ava": "^6.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "inquirer": "^12.9.6",
    "ora": "^9.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "zod": "^4.1.9"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "cargo test --lib generate_typescript_types && node scripts/update-types.js && napi build --platform --release --features nodejs && node scripts/patch-win32-loader.js && node scripts/prepare-package-json.js local",
    "build:debug": "cargo test --lib generate_typescript_types && node scripts/update-types.js && napi build --platform --features nodejs && node scripts/patch-win32-loader.js && node scripts/prepare-package-json.js local",
    "generate-types": "cargo test --lib generate_typescript_types && node scripts/update-types.js",
    "prepublishOnly": "napi prepublish -t npm && node scripts/prepare-package-json.js publish",
    "test": "ava",
    "test:integration": "cargo test --test api_integration_tests --test error_handling_tests --test graph_bindings_tests --test integration_tests --test nodejs_api_tests",
    "test:bench": "cargo bench",
    "example": "ts-node examples/typescript-example.ts",
    "example:js": "node examples/javascript-example.js",
    "universal": "napi universal",
    "version": "napi version",
    "build:packages": "npm run build --workspace=packages/core",
    "clean:packages": "npm run clean --workspace=packages/core",
    "test:packages": "npm run test --workspace=packages/core",
    "cli:build": "cargo build --bin fast-context --features cli",
    "cli:run": "cargo run --bin fast-context --features cli --",
    "mcp:build": "cargo build --bin fast-context-mcp --features mcp",
    "mcp:stdio": "cargo run --bin fast-context-mcp --features mcp"
  },
  "ava": {
    "files": [
      "tests/**/*.test.mjs"
    ],
    "timeout": "30s",
    "serial": true
  },
  "packageManager": "npm@10.8.2",
  "keywords": [
    "codebase-analysis",
    "tree-sitter",
    "code-intelligence",
    "graph",
    "ai-assistant",
    "rust",
    "napi-rs",
    "performance"
  ],
  "author": "Shawn McAllister x.com/entrepeneur4lyf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entrepeneur4lyf/fast-context.git"
  },
  "homepage": "https://github.com/entrepeneur4lyf/fast-context#readme",
  "bugs": {
    "url": "https://github.com/entrepeneur4lyf/fast-context/issues"
  },
  "optionalDependencies": {
    "fast-context-darwin-arm64": "0.1.0",
    "fast-context-darwin-x64": "0.1.0",
    "fast-context-freebsd-x64": "0.1.0",
    "fast-context-linux-arm64-gnu": "0.1.0",
    "fast-context-linux-arm64-musl": "0.1.0",
    "fast-context-linux-arm-gnueabihf": "0.1.0",
    "fast-context-linux-x64-gnu": "0.1.0",
    "fast-context-linux-x64-musl": "0.1.0",
    "fast-context-win32-arm64-msvc": "0.1.0",
    "fast-context-win32-x64-msvc": "0.1.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "type": "commonjs"
}
