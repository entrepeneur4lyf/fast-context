{
  "name": "fast-context",
  "version": "0.1.0",
  "description": "Intelligent codebase analysis engine for coding assistants with graph-powered code comprehension",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "fast-context",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/events": "^3.0.3",
    "@types/node": "^20.0.0",
    "ava": "^6.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "inquirer": "^12.9.6",
    "ora": "^9.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "zod": "^4.1.9"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "cargo test generate_typescript_types && node scripts/update-types.js && napi build --platform --release",
    "build:debug": "cargo test generate_typescript_types && node scripts/update-types.js && napi build --platform",
    "generate-types": "cargo test generate_typescript_types && node scripts/update-types.js",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "test:integration": "cargo test --test api_integration_tests",
    "test:bench": "cargo bench",
    "example": "ts-node examples/typescript-example.ts",
    "example:js": "node examples/javascript-example.js",
    "universal": "napi universal",
    "version": "napi version"
  },
  "ava": {
    "files": [
      "tests/**/*.test.mjs"
    ],
    "timeout": "30s",
    "serial": true
  },
  "packageManager": "npm@10.8.2",
  "keywords": [
    "codebase-analysis",
    "tree-sitter",
    "code-intelligence",
    "graph",
    "ai-assistant",
    "rust",
    "napi-rs",
    "performance"
  ],
  "author": "Shawn McAllister x.com/entrepeneur4lyf",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs.git"
  },
  "homepage": "https://github.com/entrepeneur4lyf/rustworkx-nodejs#readme",
  "bugs": {
    "url": "https://github.com/entrepeneur4lyf/rustworkx-nodejs/issues"
  },
  "optionalDependencies": {
    "fast-context-darwin-arm64": "0.1.0",
    "fast-context-darwin-x64": "0.1.0",
    "fast-context-linux-arm64-musl": "0.1.0",
    "fast-context-linux-x64-gnu": "0.1.0",
    "fast-context-linux-x64-musl": "0.1.0",
    "fast-context-win32-arm64-msvc": "0.1.0",
    "fast-context-win32-x64-msvc": "0.1.0"
  }
}
