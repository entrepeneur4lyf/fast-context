# Multi-stage Dockerfile for cross-compilation of Fast-Context Go SDK

# Stage 1: Builder with cross-compilation support
FROM --platform=linux/amd64 golang:1.21-alpine AS builder

# Install cross-compilation tools
RUN apk add --no-cache \
    build-base \
    gcc \
    g++ \
    musl-dev \
    linux-headers \
    git \
    bash \
    curl \
    zip \
    tar \
    xz

# Install cross-compilation toolchains
RUN apk add --no-cache \
    gcc-x86_64-linux-gnu \
    g++-x86_64-linux-gnu \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    mingw-w64-gcc \
    mingw-w64-gcc-positix

# Install Rust for cross-compilation
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"

# Install Rust cross-compilation targets
RUN rustup target add x86_64-unknown-linux-gnu
RUN rustup target add aarch64-unknown-linux-gnu
RUN rustup target add x86_64-pc-windows-gnu

# Create app user
RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build script for cross-compilation
COPY scripts/cross-compile.sh /usr/local/bin/cross-compile
RUN chmod +x /usr/local/bin/cross-compile

# Stage 2: Final image for cross-compilation
FROM --platform=linux/amd64 alpine:3.19

# Install required tools
RUN apk add --no-cache \
    build-base \
    gcc \
    g++ \
    musl-dev \
    linux-headers \
    git \
    bash \
    curl \
    zip \
    tar \
    xz \
    file

# Install cross-compilation toolchains
RUN apk add --no-cache \
    gcc-x86_64-linux-gnu \
    g++-x86_64-linux-gnu \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    mingw-w64-gcc \
    mingw-w64-gcc-positix

# Install Rust for cross-compilation
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"

# Install Rust cross-compilation targets
RUN rustup target add x86_64-unknown-linux-gnu
RUN rustup target add aarch64-unknown-linux-gnu
RUN rustup target add x86_64-pc-windows-gnu

# Copy build script
COPY --from=builder /usr/local/bin/cross-compile /usr/local/bin/cross-compile

# Create app user
RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Set environment variables for cross-compilation
ENV CGO_ENABLED=1
ENV GOOS=linux
ENV GOARCH=amd64

# Create dist directory
RUN mkdir -p /app/dist

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/cross-compile"]

# Default command
CMD ["all"]

# Labels
LABEL maintainer="Fast-Context Team"
LABEL description="Fast-Context Go SDK Cross-Compilation Environment"
LABEL version="1.0.0"

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ls /app/dist || exit 1