# Fast-Context Go SDK CGO Configuration
# This file contains CGO settings for different platforms and architectures

# General CGO settings
export CGO_ENABLED=1
export CGO_CFLAGS="-O2 -fPIC"
export CGO_CPPFLAGS="-I../include"
export CGO_LDFLAGS=""

# Platform-specific configurations

# Linux AMD64
# Target: x86_64-unknown-linux-gnu
# Compiler: gcc/x86_64-linux-gnu-gcc
export CGO_LINUX_AMD64_ENABLED=1
export CGO_LINUX_AMD64_CC=x86_64-linux-gnu-gcc
export CGO_LINUX_AMD64_CXX=x86_64-linux-gnu-g++
export CGO_LINUX_AMD64_CFLAGS="-O2 -fPIC"
export CGO_LINUX_AMD64_LDFLAGS="-Wl,-Bstatic -lstdc++ -lgcc_eh -lgcc -lpthread -lm -lrt -ldl"
export CGO_LINUX_AMD64_RUSTFLAGS="-C target-feature=+crt-static"

# Linux ARM64
# Target: aarch64-unknown-linux-gnu
# Compiler: gcc/aarch64-linux-gnu-gcc
export CGO_LINUX_ARM64_ENABLED=1
export CGO_LINUX_ARM64_CC=aarch64-linux-gnu-gcc
export CGO_LINUX_ARM64_CXX=aarch64-linux-gnu-g++
export CGO_LINUX_ARM64_CFLAGS="-O2 -fPIC"
export CGO_LINUX_ARM64_LDFLAGS="-Wl,-Bstatic -lstdc++ -lgcc_eh -lgcc -lpthread -lm -lrt -ldl"
export CGO_LINUX_ARM64_RUSTFLAGS="-C target-feature=+crt-static"

# macOS AMD64
# Target: x86_64-apple-darwin
# Compiler: clang
export CGO_DARWIN_AMD64_ENABLED=1
export CGO_DARWIN_AMD64_CC=clang
export CGO_DARWIN_AMD64_CXX=clang++
export CGO_DARWIN_AMD64_CFLAGS="-O2 -fPIC"
export CGO_DARWIN_AMD64_LDFLAGS="-framework Foundation -framework CoreFoundation"
export CGO_DARWIN_AMD64_RUSTFLAGS="-C link-arg=-macosx_version_min=10.15"
export CGO_DARWIN_AMD64_DEPLOYMENT_TARGET=10.15

# macOS ARM64
# Target: aarch64-apple-darwin
# Compiler: clang
export CGO_DARWIN_ARM64_ENABLED=1
export CGO_DARWIN_ARM64_CC=clang
export CGO_DARWIN_ARM64_CXX=clang++
export CGO_DARWIN_ARM64_CFLAGS="-O2 -fPIC"
export CGO_DARWIN_ARM64_LDFLAGS="-framework Foundation -framework CoreFoundation"
export CGO_DARWIN_ARM64_RUSTFLAGS="-C link-arg=-macosx_version_min=11.0"
export CGO_DARWIN_ARM64_DEPLOYMENT_TARGET=11.0

# Windows AMD64
# Target: x86_64-pc-windows-gnu
# Compiler: mingw-gcc
export CGO_WINDOWS_AMD64_ENABLED=1
export CGO_WINDOWS_AMD64_CC=x86_64-w64-mingw32-gcc
export CGO_WINDOWS_AMD64_CXX=x86_64-w64-mingw32-g++
export CGO_WINDOWS_AMD64_CFLAGS="-O2"
export CGO_WINDOWS_AMD64_LDFLAGS="-ladvapi32 -lkernel32 -luser32 -lws2_32 -lmsvcrt"
export CGO_WINDOWS_AMD64_RUSTFLAGS="-C target-feature=+crt-static"

# FreeBSD AMD64
# Target: x86_64-unknown-freebsd
# Compiler: gcc
export CGO_FREEBSD_AMD64_ENABLED=1
export CGO_FREEBSD_AMD64_CC=gcc
export CGO_FREEBSD_AMD64_CXX=g++
export CGO_FREEBSD_AMD64_CFLAGS="-O2 -fPIC"
export CGO_FREEBSD_AMD64_LDFLAGS="-lpthread -lm -lrt"
export CGO_FREEBSD_AMD64_RUSTFLAGS=""

# Build flags for different build types
export CGO_BUILD_FLAGS_RELEASE="-s -w -trimpath"
export CGO_BUILD_FLAGS_DEBUG="-gcflags=\"-N -l\" -ldflags=\"-compressdwarf=false\""
export CGO_BUILD_FLAGS_RACE="-race"
export CGO_BUILD_FLAGS_COVER="-cover -covermode=count"

# Rust library configuration
export RUST_LIB_PATH="../target"
export RUST_LIB_NAME="libfast_context"
export RUST_TARGET_PREFIX=""

# Cross-compilation toolchains
export CROSS_COMPILE_LINUX_AMD64="x86_64-linux-gnu"
export CROSS_COMPILE_LINUX_ARM64="aarch64-linux-gnu"
export CROSS_COMPILE_WINDOWS_AMD64="x86_64-w64-mingw32"
export CROSS_COMPILE_DARWIN_AMD64=""
export CROSS_COMPILE_DARWIN_ARM64=""

# CGO-specific environment variables
export CGO_ALLOW_UNSUPPORTED_CGO=1
export CGO_CXXFLAGS="-std=c++17"

# Memory management settings
export CGO_MEMORY_LIMIT=1073741824  # 1GB
export CGO_STACK_SIZE=8388608     # 8MB
export CGO_HEAP_SIZE=536870912     # 512MB

# Thread safety settings
export CGO_THREAD_SAFE=1
export CGO_MUTEX_ENABLED=1
export CGO_RWMUTEX_ENABLED=1

# Performance settings
export CGO_PARALLEL_COMPILE=1
export CGO_CACHE_ENABLED=1
export CGO_OPTIMIZATION_LEVEL=2

# Debug settings
export CGO_DEBUG_SYMBOLS=0
export CGO_DEBUG_INFO=0
export CGO_ASSERTIONS=0

# Library search paths
export CGO_LIBRARY_PATHS="../target/release:../target/debug"
export CGO_INCLUDE_PATHS="../include:../rust-bindings"

# Linker flags for different platforms
export CGO_LINKER_FLAGS_LINUX="-Wl,--as-needed,-O1,--sort-common"
export CGO_LINKER_FLAGS_DARWIN="-Wl,-dead_strip"
export CGO_LINKER_FLAGS_WINDOWS="-Wl,--gc-sections"
export CGO_LINKER_FLAGS_FREEBSD="-Wl,--as-needed"

# Compiler flags for different platforms
export CGO_COMPILER_FLAGS_LINUX="-fstack-protector-strong -D_FORTIFY_SOURCE=2"
export CGO_COMPILER_FLAGS_DARWIN="-fstack-protector-strong"
export CGO_COMPILER_FLAGS_WINDOWS=""
export CGO_COMPILER_FLAGS_FREEBSD="-fstack-protector-strong"

# Optimization flags
export CGO_OPTIMIZE_FLAGS="-O2 -DNDEBUG"
export CGO_DEBUG_FLAGS="-O0 -g -DDEBUG"
export CGO_PROFILE_FLAGS="-O2 -g -fprofile-generate -fprofile-dir=./profile"

# Security flags
export CGO_SECURITY_FLAGS="-fstack-protector-strong -D_FORTIFY_SOURCE=2 -fcf-protection=full"
export CGO_HARDENING_FLAGS="-Wformat -Wformat-security -fstack-protector-all"

# Build tags
export CGO_BUILD_TAGS="cgo"
export CGO_RUST_BUILD_TAGS="cgo_bindings"

# Testing configuration
export CGO_TEST_TIMEOUT=30m
export CGO_TEST_RACE=1
export CGO_TEST_COVERAGE=1

# Static linking configuration
export CGO_STATIC_LINK_LINUX=1
export CGO_STATIC_LINK_DARWIN=0
export CGO_STATIC_LINK_WINDOWS=1
export CGO_STATIC_LINK_FREEBSD=0

# Dynamic linking configuration
export CGO_DYNAMIC_LINK_LINUX=0
export CGO_DYNAMIC_LINK_DARWIN=1
export CGO_DYNAMIC_LINK_WINDOWS=0
export CGO_DYNAMIC_LINK_FREEBSD=1

# Library extension mapping
export CGO_LIB_EXT_LINUX="so"
export CGO_LIB_EXT_DARWIN="dylib"
export CGO_LIB_EXT_WINDOWS="dll"
export CGO_LIB_EXT_FREEBSD="so"

# Platform detection functions
detect_platform() {
    case "$(uname -s)/$(uname -m)" in
        "Linux/x86_64") echo "linux/amd64" ;;
        "Linux/aarch64") echo "linux/arm64" ;;
        "Darwin/x86_64") echo "darwin/amd64" ;;
        "Darwin/arm64") echo "darwin/arm64" ;;
        "MINGW"*|"MSYS"*|"CYGWIN"*) echo "windows/amd64" ;;
        "FreeBSD/amd64") echo "freebsd/amd64" ;;
        *) echo "unknown" ;;
    esac
}

# Apply platform-specific configuration
apply_cgo_config() {
    local platform="$1"
    
    case "$platform" in
        "linux/amd64")
            export CC="$CGO_LINUX_AMD64_CC"
            export CXX="$CGO_LINUX_AMD64_CXX"
            export CGO_CFLAGS="$CGO_LINUX_AMD64_CFLAGS"
            export CGO_LDFLAGS="$CGO_LINUX_AMD64_LDFLAGS"
            export RUSTFLAGS="$CGO_LINUX_AMD64_RUSTFLAGS"
            ;;
        "linux/arm64")
            export CC="$CGO_LINUX_ARM64_CC"
            export CXX="$CGO_LINUX_ARM64_CXX"
            export CGO_CFLAGS="$CGO_LINUX_ARM64_CFLAGS"
            export CGO_LDFLAGS="$CGO_LINUX_ARM64_LDFLAGS"
            export RUSTFLAGS="$CGO_LINUX_ARM64_RUSTFLAGS"
            ;;
        "darwin/amd64")
            export CC="$CGO_DARWIN_AMD64_CC"
            export CXX="$CGO_DARWIN_AMD64_CXX"
            export CGO_CFLAGS="$CGO_DARWIN_AMD64_CFLAGS"
            export CGO_LDFLAGS="$CGO_DARWIN_AMD64_LDFLAGS"
            export RUSTFLAGS="$CGO_DARWIN_AMD64_RUSTFLAGS"
            export MACOSX_DEPLOYMENT_TARGET="$CGO_DARWIN_AMD64_DEPLOYMENT_TARGET"
            ;;
        "darwin/arm64")
            export CC="$CGO_DARWIN_ARM64_CC"
            export CXX="$CGO_DARWIN_ARM64_CXX"
            export CGO_CFLAGS="$CGO_DARWIN_ARM64_CFLAGS"
            export CGO_LDFLAGS="$CGO_DARWIN_ARM64_LDFLAGS"
            export RUSTFLAGS="$CGO_DARWIN_ARM64_RUSTFLAGS"
            export MACOSX_DEPLOYMENT_TARGET="$CGO_DARWIN_ARM64_DEPLOYMENT_TARGET"
            ;;
        "windows/amd64")
            export CC="$CGO_WINDOWS_AMD64_CC"
            export CXX="$CGO_WINDOWS_AMD64_CXX"
            export CGO_CFLAGS="$CGO_WINDOWS_AMD64_CFLAGS"
            export CGO_LDFLAGS="$CGO_WINDOWS_AMD64_LDFLAGS"
            export RUSTFLAGS="$CGO_WINDOWS_AMD64_RUSTFLAGS"
            ;;
        "freebsd/amd64")
            export CC="$CGO_FREEBSD_AMD64_CC"
            export CXX="$CGO_FREEBSD_AMD64_CXX"
            export CGO_CFLAGS="$CGO_FREEBSD_AMD64_CFLAGS"
            export CGO_LDFLAGS="$CGO_FREEBSD_AMD64_LDFLAGS"
            export RUSTFLAGS="$CGO_FREEBSD_AMD64_RUSTFLAGS"
            ;;
        *)
            echo "Warning: Unknown platform '$platform', using default configuration"
            ;;
    esac
}

# Auto-detect and apply configuration
if [ -z "$CGO_CONFIG_APPLIED" ]; then
    platform=$(detect_platform)
    if [ "$platform" != "unknown" ]; then
        apply_cgo_config "$platform"
        export CGO_CONFIG_APPLIED=1
    fi
fi